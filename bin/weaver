#!/bin/bash
# Thin wrapper that resolves the caller PID and harness type before handing off to the TS CLI.
# npx spawns its own process tree, so we must capture the PID from the caller's context.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || perl -MCwd -e 'print Cwd::abs_path shift' "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Walk up from current shell to find the harness PID
get_caller_pid() {
  local pid="$PPID"
  local max_depth=10
  local depth=0

  while [ "$depth" -lt "$max_depth" ]; do
    local pname
    pname=$(ps -p "$pid" -o comm= 2>/dev/null || echo "")

    case "$pname" in
      sh|bash|zsh|dash|fish|-bash|-zsh|-sh)
        local parent
        parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ -z "$parent" ] || [ "$parent" = "1" ]; then
          break
        fi
        pid="$parent"
        depth=$((depth + 1))
        ;;
      *)
        break
        ;;
    esac
  done

  echo "$pid"
}

# Always resolve the caller PID and detect the harness, then pass both as args.
# The TS CLI decides what to do with them.
CALLER_PID=$(get_caller_pid)

# Detect harness by checking the binary name at the resolved PID.
# Uses comm= (executable name) rather than args= to avoid false positives
# from filenames or arguments that happen to contain "claude".
detect_harness() {
  local pid="$1"
  local pname
  pname=$(ps -p "$pid" -o comm= 2>/dev/null || echo "")

  case "$pname" in
    claude*) echo "claude-code" ;;
    *)       echo "kiro-cli" ;;
  esac
}

HARNESS=$(detect_harness "$CALLER_PID")

# Packaged app: cli/dist sits next to bin/ inside Contents/Resources.
# Dev mode: run from source via tsx.
if [ -f "$ROOT_DIR/cli/dist/index.mjs" ] && [ ! -d "$ROOT_DIR/cli/src" ]; then
  exec node "$ROOT_DIR/cli/dist/index.mjs" "$CALLER_PID" "$HARNESS" "$@"
else
  exec npx --prefix "$ROOT_DIR/cli" tsx "$ROOT_DIR/cli/src/index.ts" "$CALLER_PID" "$HARNESS" "$@"
fi
