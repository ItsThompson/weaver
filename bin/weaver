#!/bin/bash
# Thin wrapper that resolves the kiro-cli PID before handing off to the TS CLI.
# npx spawns its own process tree, so we must capture the PID from the caller's context.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || perl -MCwd -e 'print Cwd::abs_path shift' "$0")"
CLI_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)/cli"

# Walk up from current shell to find the kiro-cli PID
get_caller_pid() {
  local pid="$PPID"
  local max_depth=10
  local depth=0

  while [ "$depth" -lt "$max_depth" ]; do
    local pname
    pname=$(ps -p "$pid" -o comm= 2>/dev/null || echo "")

    case "$pname" in
      sh|bash|zsh|dash|fish|-bash|-zsh|-sh)
        local parent
        parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ -z "$parent" ] || [ "$parent" = "1" ]; then
          break
        fi
        pid="$parent"
        depth=$((depth + 1))
        ;;
      *)
        break
        ;;
    esac
  done

  echo "$pid"
}

# Delegate 'chat' directly to the acp-client package
if [ "${1:-}" = "chat" ]; then
  shift
  ACP_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)/acp-client"
  exec npx --prefix "$ACP_DIR" tsx "$ACP_DIR/src/index.ts" "$@"
fi

# Always resolve the caller PID and pass it as the first arg.
# The TS CLI decides what to do with it.
CALLER_PID=$(get_caller_pid)
exec npx --prefix "$CLI_DIR" tsx "$CLI_DIR/src/index.ts" "$CALLER_PID" "$@"
