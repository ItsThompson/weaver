{
  "name": "weaver",
  "version": "1.6.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "cli",
    "bindings/kiro",
    "bindings/claude-code",
    "bindings/pi",
    "validation",
    "desktop",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev --filter=weaver-server --filter=weaver-client",
    "app": "turbo build --filter=weaver-client --filter=weaver-server --filter=weaver-cli --filter=weaver-electron && npm start --prefix desktop",
    "build:whisper": "bash scripts/build-whisper.sh",
    "dist": "npm run version:sync && npm run build:whisper && turbo build --filter=weaver-client --filter=weaver-server --filter=weaver-cli --filter=weaver-electron && npm run dist --prefix desktop",
    "build": "turbo build",
    "start": "turbo build && node server/dist/index.js",
    "lint": "eslint '**/*.{ts,tsx}' --ignore-pattern '**/dist/**'",
    "test": "turbo test",
    "test:e2e": "npm test --prefix e2e",
    "version:sync": "npm version $(node -p 'require(`./package.json`).version') --workspaces --no-git-tag-version --allow-same-version"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "turbo": "^2.4.0",
    "typescript-eslint": "^8.57.0"
  }
}
