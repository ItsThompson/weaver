{
  "name": "weaver",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "cli",
    "hook-handler",
    "desktop",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev --filter=weaver-server --filter=weaver-client",
    "app": "turbo build --filter=weaver-client --filter=weaver-server --filter=weaver-electron && npm start --prefix desktop",
    "dist": "turbo build --filter=weaver-client --filter=weaver-server --filter=weaver-electron && npm run dist --prefix desktop",
    "build": "turbo build",
    "start": "turbo build && node server/dist/index.js",
    "test": "turbo test",
    "test:e2e": "npm test --prefix e2e"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "^2.4.0"
  }
}
