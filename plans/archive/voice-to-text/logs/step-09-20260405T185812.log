```typescript
function useDictation() {
  const [state, setState] = useState<DictationState>(initialState);
  const audio = useAudioCapture();
  const transcriptRef = useRef("");
  const pendingRef = useRef<Promise<void>>(Promise.resolve());
  
  // Register chunk handler
  useEffect(() => {
    audio.onChunk(async (blob) => {
      // Chain transcription requests
      pendingRef.current = pendingRef.current.then(async () => {
        const { text } = await transcribeAudio(blob);
        transcriptRef.current += text;
        setState(s => ({ ...s, rawTranscript: transcriptRef.current }));
      });
    });
  }, []);
  
  const checkServices = async () => {
    setState(s => ({ ...s, phase: "preflight_checking" }));
    try {
      const status = await getDictationStatus();
      setState(s => ({
        ...s,
        whisperStatus: status.whisper || !!status.model,
        ollamaStatus: status.ollama,
        phase: status.ollama ? "ready" : "error",
        error: !status.ollama ? "Ollama is not available" : null,
      }));
    } catch {
      setState(s => ({ ...s, phase: "error", error: "Failed to check services" }));
    }
  };
  
  const startDictation = () => {
    transcriptRef.current = "";
    setState(s => ({ ...s, phase: "recording", rawTranscript: "", processedText: "", error: null }));
    audio.startRecording();
  };
  
  const stopDictation = async () => {
    audio.stopRecording();
    setState(s => ({ ...s, phase: "processing" }));
    // Wait for pending transcriptions
    await pendingRef.current;
    // Process
    const snippets = ...; // need to get snippets
    const result = await processTranscript(transcriptRef.current, snippets);
    setState(s => ({ ...s, phase: "done", processedText: result.processedText }));
  };
}
```

