#!/usr/bin/env bash
# Ralph Wiggum Loop: generic sequential agent executor
# Usage: run-loop.sh --agent <name> --plan <path> --progress <path> [options]
#
# Modes:
#   default       Fully automated. Agent runs with --no-interactive, output piped to log.
#   --supervised  Interactive. You can type mid-step to course-correct. /quit to advance.
set -euo pipefail

# -- Defaults -----------------------------------------------------------------
AGENT=""
PLAN=""
PROGRESS=""
LOG_DIR=""
MAX_STEPS="${MAX_STEPS:-16}"
MAX_STALLS="${MAX_STALLS:-2}"
SUPERVISED=false
PROMPT="Execute your task. Read current-step.md and progress.md first. Do ONLY the single step described in current-step.md, then update progress and stop."

# -- Parse args ---------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent)       AGENT="$2";      shift 2 ;;
    --plan)        PLAN="$2";       shift 2 ;;
    --progress)    PROGRESS="$2";   shift 2 ;;
    --log-dir)     LOG_DIR="$2";    shift 2 ;;
    --max-steps)   MAX_STEPS="$2";  shift 2 ;;
    --max-stalls)  MAX_STALLS="$2"; shift 2 ;;
    --supervised)  SUPERVISED=true; shift ;;
    *) echo "Unknown arg: $1"; exit 1 ;;
  esac
done

if [[ -z "$AGENT" || -z "$PLAN" || -z "$PROGRESS" ]]; then
  echo "Usage: run-loop.sh --agent <name> --plan <path> --progress <path> [--log-dir <path>] [--max-steps N] [--max-stalls N] [--supervised]"
  exit 1
fi

# Expand ~ in paths
PLAN="${PLAN/#\~/$HOME}"
PROGRESS="${PROGRESS/#\~/$HOME}"
[[ -n "$LOG_DIR" ]] && LOG_DIR="${LOG_DIR/#\~/$HOME}"

# Default log dir next to the progress file
if [[ -z "$LOG_DIR" ]]; then
  LOG_DIR="$(dirname "$PROGRESS")/logs"
fi

# -- Colors -------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

log()  { echo -e "${DIM}[$(date +%H:%M:%S)]${RESET} $*"; }
info() { log "${BLUE}i${RESET} $*"; }
ok()   { log "${GREEN}✓${RESET} $*"; }
warn() { log "${YELLOW}⚠${RESET} $*"; }
err()  { log "${RED}✗${RESET} $*"; }

# -- Preflight ----------------------------------------------------------------
if ! command -v kiro-cli &>/dev/null; then
  err "kiro-cli not found in PATH"; exit 1
fi

if [[ ! -f "$PLAN" ]]; then
  err "Implementation plan not found: $PLAN"; exit 1
fi

if [[ ! -f "$PROGRESS" ]]; then
  err "Progress file not found: $PROGRESS"; exit 1
fi

mkdir -p "$LOG_DIR"

# -- Validate plan format -----------------------------------------------------
if ! grep -qi '^## Implementation Steps' "$PLAN"; then
  err "Plan missing '## Implementation Steps' heading (needed by extract_overview)"
  exit 1
fi
if ! grep -qiE '^### Step [0-9]+:' "$PLAN"; then
  err "Plan missing '### Step N:' headers (needed by extract_step)"
  exit 1
fi

# -- Step extraction ----------------------------------------------------------
# Extracts the overview/approach sections (everything before "## Implementation Steps")
extract_overview() {
  awk 'tolower($0) ~ /^## implementation steps/ { exit } { print }' "$1"
}

# Extracts a single step section by number (from ### Step N to the next ### Step or ## heading)
extract_step() {
  local plan="$1" step_num="$2"
  awk -v n="$step_num" '
    /^### Step [0-9]/ {
      if (found) exit
      split($3, a, ":")
      if (a[1]+0 == n+0) found=1
    }
    /^## [^#]/ { if (found) exit }
    found { print }
  ' "$plan"
}

# Returns the step number of the first "⬜ Not started" row
next_step_number() {
  grep -E '^\| [0-9]+ \|' "$PROGRESS" | grep '⬜ Not started' | head -1 | awk -F'|' '{ gsub(/[ \t]+/, "", $2); print $2 }'
}

# Writes current-step.md with overview context + the single next step
write_current_step() {
  local step_num="$1"
  local step_file="$(dirname "$PROGRESS")/current-step.md"
  {
    extract_overview "$PLAN"
    echo ""
    echo "---"
    echo ""
    echo "# YOUR TASK — Step $step_num (do ONLY this step, then stop)"
    echo ""
    extract_step "$PLAN" "$step_num"
  } > "$step_file"
  echo "$step_file"
}

# -- Progress parsing ---------------------------------------------------------
count_remaining() {
  local n
  n=$(grep -E '^\| [0-9]+ \|' "$PROGRESS" | grep -c '⬜ Not started' 2>/dev/null) || true
  echo "${n:-0}"
}

count_complete() {
  local n
  n=$(grep -E '^\| [0-9]+ \|' "$PROGRESS" | grep -c '✅ Complete' 2>/dev/null) || true
  echo "${n:-0}"
}

total_steps() {
  local n
  n=$(grep -cE '^\| [0-9]+ \|' "$PROGRESS" 2>/dev/null) || true
  echo "${n:-0}"
}

print_status() {
  local done remaining total
  done=$(count_complete)
  remaining=$(count_remaining)
  total=$(total_steps)
  echo ""
  echo -e "${BOLD}-- Progress -----------------------------------------------${RESET}"
  echo -e "  ${GREEN}Complete:${RESET}  ${done} / ${total}"
  echo -e "  ${YELLOW}Remaining:${RESET} ${remaining}"
  grep -E '^\| [0-9]' "$PROGRESS" | while IFS='|' read -r _ step desc status _; do
    step=$(echo "$step" | xargs)
    desc=$(echo "$desc" | xargs)
    status=$(echo "$status" | xargs)
    if [[ "$status" == *"✅"* ]]; then
      echo -e "  ${GREEN}✓${RESET} Step $step: $desc"
    elif [[ "$status" == *"🔄"* ]]; then
      echo -e "  ${YELLOW}→${RESET} Step $step: $desc"
    else
      echo -e "  ${DIM}○ Step $step: $desc${RESET}"
    fi
  done
  echo -e "${BOLD}-----------------------------------------------------------${RESET}"
  echo ""
}

# -- Validate step count consistency ------------------------------------------
PLAN_STEPS=$(grep -ciE '^### Step [0-9]+:' "$PLAN")
PROGRESS_STEPS=$(total_steps)
if [[ "$PLAN_STEPS" -ne "$PROGRESS_STEPS" ]]; then
  err "Step count mismatch: plan has $PLAN_STEPS steps, progress.md has $PROGRESS_STEPS"
  exit 1
fi

# -- Main loop ----------------------------------------------------------------
stall_count=0
iteration=0
start_time=$(date +%s)

# Derive banner from agent name
BANNER=$(echo "$AGENT" | tr '-' ' ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1')

MODE_LABEL="automated"
if $SUPERVISED; then
  MODE_LABEL="supervised (type mid-step to intervene, /quit to advance)"
fi

echo ""
echo -e "${BOLD}${CYAN}🔄 Ralph Wiggum Loop: ${BANNER}${RESET}"
echo -e "${DIM}   Agent: $AGENT${RESET}"
echo -e "${DIM}   Mode: $MODE_LABEL${RESET}"
echo -e "${DIM}   Max steps: $MAX_STEPS | Max stalls: $MAX_STALLS${RESET}"
print_status

while true; do
  remaining=$(count_remaining)

  # -- Done? --
  if [[ "$remaining" -eq 0 ]]; then
    elapsed=$(( $(date +%s) - start_time ))
    ok "${BOLD}All tasks complete!${RESET} ($iteration iterations, ${elapsed}s elapsed)"
    print_status
    exit 0
  fi

  # -- Guard: max iterations --
  iteration=$((iteration + 1))
  if [[ "$iteration" -gt "$MAX_STEPS" ]]; then
    warn "Hit max steps ($MAX_STEPS). Stopping."
    print_status
    exit 1
  fi

  # -- Launch agent --
  before_complete=$(count_complete)
  step_log="$LOG_DIR/step-$(printf '%02d' "$iteration")-$(date +%Y%m%dT%H%M%S).log"

  # Write scoped context: overview + only the current step (not the full plan)
  NEXT_STEP=$(next_step_number)
  STEP_FILE=$(write_current_step "$NEXT_STEP")

  # Verify the step was actually extracted (catches plan format mismatches)
  if ! grep -q "^### Step" "$STEP_FILE"; then
    err "Failed to extract step $NEXT_STEP from plan. Check '### Step N:' header format."
    exit 1
  fi

  info "${BOLD}Iteration $iteration${RESET} (step $NEXT_STEP): $remaining tasks remaining"
  info "Log: ${DIM}$step_log${RESET}"
  echo ""

  step_start=$(date +%s)

  set +e
  if $SUPERVISED; then
    # Interactive: stdin stays connected, output teed to log via process substitution
    kiro-cli chat \
      --agent "$AGENT" \
      --trust-all-tools \
      --wrap never \
      "$PROMPT" > >(tee "$step_log") 2>&1
    exit_code=$?
  else
    # Automated: no stdin, output piped to log
    kiro-cli chat \
      --agent "$AGENT" \
      --no-interactive \
      --trust-all-tools \
      --wrap never \
      "$PROMPT" 2>&1 | tee "$step_log"
    exit_code=${PIPESTATUS[0]}
  fi
  set -e

  step_elapsed=$(( $(date +%s) - step_start ))

  echo ""
  info "Agent exited (code: $exit_code, ${step_elapsed}s)"

  # -- Check progress format integrity --
  # If an agent corrupted the table, bail before misparsing
  if ! grep -qE '^\| [0-9]+ \|' "$PROGRESS"; then
    err "progress.md table format corrupted — no parseable rows found. Check: $step_log"
    exit 3
  fi

  # -- Check progress --
  after_complete=$(count_complete)
  steps_done=$((after_complete - before_complete))

  if [[ "$steps_done" -gt 1 ]]; then
    warn "${BOLD}Agent completed $steps_done steps in one session (expected 1).${RESET} Runaway agent detected."
  fi

  if [[ "$steps_done" -ge 1 ]]; then
    ok "Step completed (${before_complete} → ${after_complete})"
    stall_count=0
  else
    stall_count=$((stall_count + 1))
    warn "No progress detected (stall $stall_count/$MAX_STALLS)"

    if [[ "$stall_count" -ge "$MAX_STALLS" ]]; then
      err "Hit max stalls ($MAX_STALLS). Agent may be stuck. Stopping."
      err "Check the last log: $step_log"
      print_status
      exit 2
    fi
  fi

  print_status

  # Brief pause between iterations
  sleep 2
done
