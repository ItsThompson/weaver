  echo ""

  step_start=$(date +%s)

  set +e
  if $SUPERVISED; then
    # Interactive: stdin stays connected, output teed to log via process substitution
    kiro-cli chat \
      --agent "$AGENT" \
      --trust-all-tools \
      --wrap never \
      "$PROMPT" > >(tee "$step_log") 2>&1
    exit_code=$?
  else
    # Automated: no stdin, output piped to log
    kiro-cli chat \
      --agent "$AGENT" \
      --no-interactive \
      --trust-all-tools \
      --wrap never \
      "$PROMPT" 2>&1 | tee "$step_log"
    exit_code=${PIPESTATUS[0]}
  fi
  set -e

  step_elapsed=$(( $(date +%s) - step_start ))

  echo ""
  info "Agent exited (code: $exit_code, ${step_elapsed}s)"

  # -- Check progress format integrity --
  # If an agent corrupted the table, bail before misparsing
  if ! grep -qE '^\| [0-9]+ \|' "$PROGRESS"; then
    err "progress.md table format corrupted — no parseable rows found. Check: $step_log"
    exit 3
  fi

  # -- Check progress --
  after_complete=$(count_complete)
  steps_done=$((after_complete - before_complete))

  if [[ "$steps_done" -gt 1 ]]; then
    warn "${BOLD}Agent completed $steps_done steps in one session (expected 1).${RESET} Runaway agent detected."
  fi

  if [[ "$steps_done" -ge 1 ]]; then
    ok "Step completed (${before_complete} → ${after_complete})"
    stall_count=0
  else
    stall_count=$((stall_count + 1))
    warn "No progress detected (stall $stall_count/$MAX_STALLS)"

    if [[ "$stall_count" -ge "$MAX_STALLS" ]]; then
      err "Hit max stalls ($MAX_STALLS). Agent may be stuck. Stopping."
      err "Check the last log: $step_log"
      print_status
      exit 2
    fi
  fi

  print_status

  # Brief pause between iterations
  sleep 2
done

