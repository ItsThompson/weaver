Let me write the hook now. The key logic:

```ts
export function useF4Dictation() {
  const [f4Active, setF4Active] = useState(false);
  const audio = useAudioCapture();
  const transcriptRef = useRef("");
  const pendingRef = useRef<Promise<void>>(Promise.resolve());
  const stoppingRef = useRef(false);

  // Set up chunk handler
  useEffect(() => {
    audio.onChunk((blob: Blob) => {
      pendingRef.current = pendingRef.current.then(async () => {
        try {
          const { text } = await transcribeAudio(blob);
          transcriptRef.current += text;
        } catch { /* non-fatal */ }
      });
    });
  }, [audio]);

  // Process after stop
  useEffect(() => {
    if (!stoppingRef.current || audio.isRecording) return;
    stoppingRef.current = false;

    const run = async () => {
      await pendingRef.current;
      const transcript = transcriptRef.current;
      if (!transcript.trim()) {
        window.weaver?.sendDictationComplete("");
        playNotificationSound("dictation-done");
        setF4Active(false);
        return;
      }
      try {
        const { snippets } = await getSnippets();
        const result = await processTranscript(transcript, snippets);
        window.weaver?.sendDictationComplete(result.processedText);
        playNotificationSound("dictation-done");
      } catch (err) {
        window.weaver?.sendDictationError(
          err instanceof Error ? err.message : "Processing failed"
        );
      }
      setF4Active(false);
    };
    run();
  }, [audio.isRecording]);

  // Listen for F4 commands
  useEffect(() => {
    if (!window.weaver?.onDictationCommand) return;
    
    window.weaver.onDictationCommand((_event, command) => {
      if (command === "start") {
        setF4Active(true);
        transcriptRef.current = "";
        pendingRef.current = Promise.resolve();
        playNotificationSound("dictation-start");
        audio.startRecording();
      } else if (command === "stop") {
        playNotificationSound("dictation-stop");
        stoppingRef.current = true;
        audio.stopRecording();
      }
    });
  }, [audio]);

  return { f4Active };
}
```

