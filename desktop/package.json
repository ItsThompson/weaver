{
  "name": "weaver-electron",
  "version": "1.1.0",
  "description": "Weaver desktop app",
  "author": "thompsnt",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "start": "electron dist/main.cjs",
    "dev": "tsdown && electron dist/main.cjs",
    "pack": "tsdown && npx electron-builder --mac --dir",
    "dist": "tsdown && npx electron-builder --mac"
  },
  "build": {
    "appId": "com.weaver.app",
    "productName": "Weaver",
    "electronVersion": "35.7.5",
    "mac": {
      "icon": "assets/desktop-icon.png",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../bin",
        "to": "bin"
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      },
      {
        "from": "../cli/dist",
        "to": "cli/dist"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "tsdown": "^0.21.0",
    "typescript": "^5.8.3"
  }
}
