{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "e2e-playwright",
  "description": "Playwright E2E test implementation agent for the Ralph Wiggum Loop. Executes one task per session from the implementation plan.",
  "prompt": "file://./e2e-playwright-prompt.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "thinking"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**",
        "~/Desktop/weaver-playwright-e2e-*"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "./e2e/**",
        "./desktop/src/main.ts",
        "./desktop/src/window.ts",
        "./package.json",
        "./turbo.json",
        "./.gitignore",
        "~/Desktop/weaver-playwright-e2e-progress.md"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "npm install *",
        "npm test *",
        "npm run *",
        "npx playwright *",
        "mktemp *",
        "mkdir *",
        "node *",
        "rm *",
        "turbo *",
        "git add *",
        "git commit *",
        "git status *",
        "git diff *"
      ],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "file:///Users/thompsnt/Desktop/weaver-playwright-e2e-implementation-plan.md",
    "file:///Users/thompsnt/Desktop/weaver-playwright-e2e-progress.md",
    "file://README.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log agent spawn event"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log user prompt submission"
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log pre-tool-use for all tools"
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log post-tool-use for all tools"
      }
    ],
    "stop": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log turn completion"
      }
    ]
  },
  "useLegacyMcpJson": false
}
