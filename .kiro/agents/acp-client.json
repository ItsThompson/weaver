{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "acp-client",
  "description": "ACP client implementation agent for the Ralph Wiggum Loop. Executes one step per session from the implementation plan.",
  "prompt": "file://./acp-client-prompt.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code",
    "thinking",
    "web_fetch"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "thinking",
    "web_fetch"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**",
        "~/Desktop/Weaver-ACP-Client-*",
        "~/Desktop/weaver/**",
        "~/Documents/agent-client-protocol/**"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "./shared/db/**",
        "./shared/package.json",
        "./shared/tsconfig.json",
        "./shared/types/**",
        "./acp-client/**",
        "./server/src/**",
        "./server/package.json",
        "./bin/weaver",
        "./cli/src/index.ts",
        "./hook-handler/**",
        "./package.json",
        "./turbo.json",
        "./.gitignore",
        "~/Desktop/Weaver-ACP-Client-Progress.md"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "npm install *",
        "npm test *",
        "npm run *",
        "npx jest *",
        "npx tsx *",
        "node *",
        "turbo *",
        "git add *",
        "git commit *",
        "git status *",
        "git diff *",
        "mkdir *",
        "rm *",
        "cat *",
        "ls *"
      ],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "file:///Users/thompsnt/Desktop/Weaver-ACP-Client-Implementation-Plan.md",
    "file:///Users/thompsnt/Desktop/Weaver-ACP-Client-Progress.md",
    "file://README.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log agent spawn event"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log user prompt submission"
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log pre-tool-use for all tools"
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log post-tool-use for all tools",
        "timeout_ms": 35000
      }
    ],
    "stop": [
      {
        "command": "~/.config/amazonq/global/hooks/weaver-log.sh",
        "description": "Weaver: log turn completion",
        "timeout_ms": 165000
      }
    ]
  },
  "useLegacyMcpJson": false
}
